# .env.example  (copy to .env and fill in your values)
SECRET_KEY=change_me_to_a_strong_random_value
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/medical
OPENAI_API_KEY=sk-your-openai-api-key-here
VECTOR_STORE=pgvector

# Optional CORS whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:19006

# Frontend API URL configuration
EXPO_PUBLIC_API_URL=http://localhost:8000

